PUBLIC_DOMAIN=soccer.example.com
APP_ENV=production
APP_NAME=Soccer Intelligence Platform
API_V1_PREFIX=/api/v1
FRONTEND_ORIGIN=https://soccer.example.com
TRUSTED_HOSTS=soccer.example.com

POSTGRES_DB=soccer_intel
POSTGRES_USER=soccer_app
POSTGRES_PASSWORD=REPLACE_WITH_LONG_RANDOM_PASSWORD
DATABASE_URL=postgresql+asyncpg://soccer_app:REPLACE_WITH_URL_ENCODED_PASSWORD@postgres:5432/soccer_intel
REDIS_PASSWORD=REPLACE_WITH_LONG_RANDOM_PASSWORD
REDIS_URL=redis://:REPLACE_WITH_URL_ENCODED_PASSWORD@redis:6379/0

JWT_SECRET=REPLACE_WITH_64_PLUS_RANDOM_CHARACTERS
JWT_ALGORITHM=HS256
JWT_ISSUER=soccer-intelligence-platform
JWT_AUDIENCE=soccer-intelligence-web
ACCESS_TOKEN_MINUTES=60

FOOTBALL_DATA_API_KEY=REPLACE_ME
FOOTBALL_DATA_BASE_URL=https://api.football-data.org/v4
DEFAULT_COMPETITIONS=PL,CL,PD,BL1,SA,FL1
LIVE_POLL_SECONDS=30
UPCOMING_DAYS=7
PROVIDER_RPM_BUDGET=8
PROVIDER_TIMEOUT_SECONDS=20

# Set initials for the safest public portfolio deployment unless you have crest rights.
CREST_POLICY=initials
SNAPSHOT_RETENTION_DAYS=14
DEMO_SESSION_TTL_SECONDS=3600

ENABLE_LLM_ANALYST=false
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-luna
XG_MODEL_PATH=models/xg_model.joblib
XG_MODEL_CARD_PATH=models/xg_model_card.json
