# Copy to .env for local development. Never commit real API keys.
FOOTBALL_DATA_API_KEY=

APP_ENV=development
APP_NAME=Soccer Intelligence Platform
API_V1_PREFIX=/api/v1
FRONTEND_ORIGIN=http://localhost:5173
TRUSTED_HOSTS=localhost,127.0.0.1

POSTGRES_DB=soccer_intel
POSTGRES_USER=soccer
POSTGRES_PASSWORD=soccer-local-only
DATABASE_URL=postgresql+asyncpg://soccer:soccer-local-only@postgres:5432/soccer_intel
REDIS_PASSWORD=redis-local-only
REDIS_URL=redis://:redis-local-only@redis:6379/0
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=grafana-local-only

JWT_SECRET=dev-only-change-me
JWT_ALGORITHM=HS256
JWT_ISSUER=soccer-intelligence-platform
JWT_AUDIENCE=soccer-intelligence-web
ACCESS_TOKEN_MINUTES=120

FOOTBALL_DATA_BASE_URL=https://api.football-data.org/v4
DEFAULT_COMPETITIONS=PL,CL,PD,BL1,SA,FL1
LIVE_POLL_SECONDS=30
UPCOMING_DAYS=7
PROVIDER_RPM_BUDGET=8
PROVIDER_TIMEOUT_SECONDS=20
CREST_POLICY=provider
SNAPSHOT_RETENTION_DAYS=14
DEMO_SESSION_TTL_SECONDS=3600

# Optional grounded LLM analyst. Disabled by default.
ENABLE_LLM_ANALYST=false
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-luna

XG_MODEL_PATH=models/xg_model.joblib
XG_MODEL_CARD_PATH=models/xg_model_card.json
